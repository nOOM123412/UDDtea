import asyncio
import json
import os

from aiogram import Bot, Dispatcher, F
from aiogram.client.default import DefaultBotProperties
from aiogram.enums import ParseMode
from aiogram.filters import CommandStart
from aiogram.types import (
    Message,
    CallbackQuery,
    InlineKeyboardMarkup,
    InlineKeyboardButton,
    FSInputFile,
)

# ==========================================
# ТОКЕН БОТА
# ==========================================
TOKEN = "8512205904:AAEZsjDnJI5fs8dfvp1QJPp3hC3JHBevZ-o"

bot = Bot(
    token=TOKEN,
    default=DefaultBotProperties(parse_mode=ParseMode.HTML)
)

dp = Dispatcher()

# ==========================================
# ФАЙЛ БАЗЫ ДАННЫХ
# ==========================================
DB_FILE = "users.json"

# ==========================================
# ПУТЬ К ФОТО
# ==========================================
PHOTO_PATH = "/app/shared/tmpqe0mpymm.jpg"


# ==========================================
# ЗАГРУЗКА БАЗЫ ДАННЫХ
# ==========================================
def load_db():
    if not os.path.exists(DB_FILE):
        return {}

    with open(DB_FILE, "r", encoding="utf-8") as file:
        return json.load(file)


# ==========================================
# СОХРАНЕНИЕ БАЗЫ ДАННЫХ
# ==========================================
def save_db(data):
    with open(DB_FILE, "w", encoding="utf-8") as file:
        json.dump(
            data,
            file,
            ensure_ascii=False,
            indent=4
        )


db = load_db()


# ==========================================
# КНОПКИ ПОДТВЕРЖДЕНИЯ
# ==========================================
def confirm_keyboard():
    return InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(
                    text="Отправить",
                    callback_data="send_form"
                ),
                InlineKeyboardButton(
                    text="Переписать",
                    callback_data="rewrite_form"
                )
            ]
        ]
    )


# ==========================================
# ГЛАВНОЕ МЕНЮ
# ==========================================
def main_menu():
    return InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(
                    text="Профиль",
                    callback_data="profile"
                ),
                InlineKeyboardButton(
                    text="Зеркало",
                    callback_data="mirror"
                )
            ],
            [
                InlineKeyboardButton(
                    text="Каналы",
                    callback_data="channels"
                ),
                InlineKeyboardButton(
                    text="Помощь",
                    callback_data="help"
                )
            ],
            [
                InlineKeyboardButton(
                    text="Настройки",
                    callback_data="settings"
                ),
                InlineKeyboardButton(
                    text="Ресурсы",
                    callback_data="resources"
                )
            ]
        ]
    )


# ==========================================
# ОТПРАВКА ГЛАВНОГО МЕНЮ
# ==========================================
async def send_main_menu(user_id):
    await bot.send_photo(
        chat_id=user_id,
        photo=FSInputFile(PHOTO_PATH),
        caption="Панель управления",
        reply_markup=main_menu()
    )


# ==========================================
# КОМАНДА /start
# ==========================================
@dp.message(CommandStart())
async def start_handler(message: Message):
    user_id = str(message.from_user.id)

    # Если пользователь уже одобрен
    if user_id in db and db[user_id].get("approved"):
        await send_main_menu(message.from_user.id)
        return

    # Новый пользователь
    await message.answer(
        "Добро пожаловать в UDD team!\n\n"
        "Просим вас оставить заявку для вступления по форме ниже:\n\n"
        "1. Ваш опыт работы.\n"
        "2. Рабочее время.\n"
        "3. Откуда узнали о нас?"
    )


# ==========================================
# ПОЛУЧЕНИЕ ЗАЯВКИ
# ==========================================
@dp.message()
async def form_handler(message: Message):
    user_id = str(message.from_user.id)

    # Если уже одобрен
    if user_id in db and db[user_id].get("approved"):
        await send_main_menu(message.from_user.id)
        return

    # Сохраняем заявку
    db[user_id] = {
        "form": message.text,
        "approved": False
    }

    save_db(db)

    # Подтверждение
    await message.answer(
        f'Ваша заявка:\n\n"{message.text}"\n\nВсё верно?',
        reply_markup=confirm_keyboard()
    )


# ==========================================
# ПЕРЕПИСАТЬ
# ==========================================
@dp.callback_query(F.data == "rewrite_form")
async def rewrite_form(callback: CallbackQuery):
    await callback.message.answer(
        "Заполните заявку заново:\n\n"
        "1. Ваш опыт работы.\n"
        "2. Рабочее время.\n"
        "3. Откуда узнали о нас?"
    )

    await callback.answer()


# ==========================================
# ОТПРАВИТЬ ЗАЯВКУ
# ==========================================
@dp.callback_query(F.data == "send_form")
async def send_form(callback: CallbackQuery):
    user_id = str(callback.from_user.id)

    # Сообщение об отправке
    await callback.message.answer(
        "Ваша заявка отправлена, ожидайте решения модерации."
    )

    await callback.answer()

    # Ожидание 5 секунд
    await asyncio.sleep(5)

    # Одобряем пользователя
    db[user_id]["approved"] = True
    save_db(db)

    # Отправляем меню
    await bot.send_photo(
        chat_id=callback.from_user.id,
        photo=FSInputFile(PHOTO_PATH),
        caption="Ваша заявка была одобрена!\n\nПанель управления",
        reply_markup=main_menu()
    )


# ==========================================
# ПРОФИЛЬ
# ==========================================
@dp.callback_query(F.data == "profile")
async def profile_handler(callback: CallbackQuery):
    await bot.send_photo(
        chat_id=callback.from_user.id,
        photo=FSInputFile(PHOTO_PATH),
        caption="Это ваш профиль.",
        reply_markup=main_menu()

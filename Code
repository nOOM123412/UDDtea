from telegram import (
    Update,
    InlineKeyboardButton,
    InlineKeyboardMarkup,
)
from telegram.ext import (
    Application,
    CommandHandler,
    MessageHandler,
    CallbackQueryHandler,
    ContextTypes,
    filters,
)
import asyncio

TOKEN = "YOUR_BOT_TOKEN"

START_TEXT = (
    "Привет, это UDD⚡️\n"
    "звполни форму:\n"
    "1. Опыт работы\n"
    "2. Уделяемое время"
)


# /start
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(START_TEXT)


# Любое сообщение
async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_text = update.message.text

    # КНОПКИ ПО ОДНОЙ В СТРОЧКЕ
    keyboard = InlineKeyboardMarkup([
        [InlineKeyboardButton("Отправить", callback_data="send")],
        [InlineKeyboardButton("Заново", callback_data="restart")],
    ])

    await update.message.reply_text(
        f'Ваше сообщение:\n"{user_text}"',
        reply_markup=keyboard
    )


# Обработка кнопок
async def buttons(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    # Заново
    if query.data == "restart":
        await query.message.reply_text(START_TEXT)

    # Отправить
    elif query.data == "send":
        await query.message.reply_text("Заявка отправлена, ожидайте...")

        await asyncio.sleep(45)

        await query.message.reply_text(
            "Ваша заявка одобрена, приступайте!"
        )

        # ГЛАВНОЕ МЕНЮ — КНОПКИ ПО ОДНОЙ В СТРОЧКЕ
        menu_keyboard = InlineKeyboardMarkup([
            [InlineKeyboardButton("Профиль", callback_data="profile")],
            [InlineKeyboardButton("Зеркало", callback_data="mirror")],
            [InlineKeyboardButton("Каналы", callback_data="channels")],
            [InlineKeyboardButton("Помощь", callback_data="help")],
        ])

        await query.message.reply_text(
            "Главное меню:",
            reply_markup=menu_keyboard
        )


def main():
    app = Application.builder().token(TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))
    app.add_handler(CallbackQueryHandler(buttons))

    print("Бот запущен...")
    app.run_polling()


if __name__ == "__main__":
    main()

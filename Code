    CallbackQuery,
    InlineKeyboardMarkup,
    InlineKeyboardButton,
    FSInputFile,
)

# =========================
# ТОКЕН БОТА
# =========================
TOKEN = "8512205904:AAEZsjDnJI5fs8dfvp1QJPp3hC3JHBevZ-o"

bot = Bot(
    token=TOKEN,
    default=DefaultBotProperties(parse_mode=ParseMode.HTML)
)

dp = Dispatcher()

# =========================
# ФАЙЛ БАЗЫ ДАННЫХ
# =========================
DB_FILE = "users.json"

# =========================
# ПУТЬ К ФОТО
# =========================
PHOTO_PATH = "/app/shared/tmpqe0mpymm.jpg"

# Если у файла другое расширение:
# PHOTO_PATH = "/app/shared/tmpqe0mpymm.png"


# =========================
# ЗАГРУЗКА БАЗЫ
# =========================
def load_db():
    if not os.path.exists(DB_FILE):
        return {}

    with open(DB_FILE, "r", encoding="utf-8") as file:
        return json.load(file)


# =========================
# СОХРАНЕНИЕ БАЗЫ
# =========================
def save_db(data):
    with open(DB_FILE, "w", encoding="utf-8") as file:
        json.dump(
            data,
            file,
            ensure_ascii=False,
            indent=4
        )


db = load_db()


# =========================
# КНОПКИ ПОДТВЕРЖДЕНИЯ
# =========================
def confirm_keyboard():
    return InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(
                    text="Отправить",
                    callback_data="send_form"
                ),
                InlineKeyboardButton(
                    text="Переписать",
                    callback_data="rewrite_form"
                )
            ]
        ]
    )


# =========================
# ГЛАВНОЕ МЕНЮ
# =========================
def main_menu():
    return InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(
                    text="Профиль",
                    callback_data="profile"
                ),
                InlineKeyboardButton(
                    text="Зеркало",
                    callback_data="mirror"
                )
            ],
            [
                InlineKeyboardButton(
                    text="Каналы",
                    callback_data="channels"
                ),
                InlineKeyboardButton(
                    text="Помощь",
                    callback_data="help"
                )
            ],
            [
                InlineKeyboardButton(
                    text="Настройки",
                    callback_data="settings"
                ),
                InlineKeyboardButton(
                    text="Ресурсы",
                    callback_data="resources"
                )
            ]
        ]
    )


# =========================
# ОТПРАВКА ПАНЕЛИ
# =========================
async def send_panel(user_id):
    photo = FSInputFile(PHOTO_PATH)

    await bot.send_photo(
        chat_id=user_id,
        photo=photo,
        caption="Панель управления",
        reply_markup=main_menu()
    )


# =========================
# КОМАНДА /start
# =========================
@dp.message(CommandStart())
async def start_handler(message: Message):
    user_id = str(message.from_user.id)

    # Если пользователь уже одобрен
    if user_id in db and db[user_id]["approved"]:
        await send_panel(message.from_user.id)
        return

    # Если пользователь новый
    await message.answer(
        "Добро пожаловать в UDD team!\n\n"
        "Просим вас оставить заявку для вступления по форме ниже:\n\n"
        "1. Ваш опыт работы.\n"
        "2. Рабочее время.\n"
        "3. Откуда узнали о нас?"
    )


# =========================
# ПОЛУЧЕНИЕ ЗАЯВКИ
# =========================
@dp.message()
async def form_handler(message: Message):
    user_id = str(message.from_user.id)

    # Сохраняем заявку
    db[user_id] = {
        "form": message.text,
        "approved": False
    }

    save_db(db)

    # Подтверждение заявки
    await message.answer(
        f'Ваша заявка:\n\n"{message.text}"\n\nВсё верно?',
        reply_markup=confirm_keyboard()
    )


# =========================
# ПЕРЕПИСАТЬ
# =========================
@dp.callback_query(F.data == "rewrite_form")
async def rewrite_form(callback: CallbackQuery):
    await callback.message.answer(
        "Заполните заявку заново:\n\n"
        "1. Ваш опыт работы.\n"
        "2. Рабочее время.\n"
        "3. Откуда узнали о нас?"
    )

    await callback.answer()


# =========================
# ОТПРАВИТЬ ЗАЯВКУ
# =========================
@dp.callback_query(F.data == "send_form")
async def send_form(callback: CallbackQuery):
    user_id = str(callback.from_user.id)

    await callback.message.answer(
        "Ваша заявка отправлена, ожидайте решения модерации."
    )

    await callback.answer()

    # Ожидание модерации
    await asyncio.sleep(50)

    # Одобрение пользователя
    db[user_id]["approved"] = True
    save_db(db)

    # Сообщение об одобрении
    await bot.send_message(
        callback.from_user.id,
        "Ваша заявка была одобрена!"
    )

    # Панель управления
    await send_panel(callback.from_user.id)



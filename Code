import asyncio
import json
import os

from aiogram import Bot, Dispatcher, F
from aiogram.client.default import DefaultBotProperties
from aiogram.enums import ParseMode
from aiogram.filters import CommandStart
from aiogram.types import (
    Message,
    CallbackQuery,
    InlineKeyboardMarkup,
    InlineKeyboardButton,
    FSInputFile,
)

# =========================
# ТОКЕН
# =========================
TOKEN = "8512205904:AAEZsjDnJI5fs8dfvp1QJPp3hC3JHBevZ-o"

bot = Bot(
    token=TOKEN,
    default=DefaultBotProperties(parse_mode=ParseMode.HTML)
)

dp = Dispatcher()

# =========================
# ФАЙЛ БАЗЫ
# =========================
DB_FILE = "users.json"

# =========================
# ФОТО
# =========================
PHOTO_PATH = "/app/shared/tmpqe0mpymm.jpg"


# =========================
# ЗАГРУЗКА БД
# =========================
def load_db():
    if not os.path.exists(DB_FILE):
        return {}
    with open(DB_FILE, "r", encoding="utf-8") as f:
        return json.load(f)


# =========================
# СОХРАНЕНИЕ БД
# =========================
def save_db(data):
    with open(DB_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=4)


db = load_db()


# =========================
# КНОПКИ ПОДТВЕРЖДЕНИЯ
# =========================
def confirm_keyboard():
    return InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(text="Отправить", callback_data="send_form"),
                InlineKeyboardButton(text="Переписать", callback_data="rewrite_form"),
            ]
        ]
    )


# =========================
# ГЛАВНОЕ МЕНЮ
# =========================
def main_menu():
    return InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(text="Профиль", callback_data="profile"),
                InlineKeyboardButton(text="Зеркало", callback_data="mirror"),
            ],
            [
                InlineKeyboardButton(text="Каналы", callback_data="channels"),
                InlineKeyboardButton(text="Помощь", callback_data="help"),
            ],
            [
                InlineKeyboardButton(text="Настройки", callback_data="settings"),
                InlineKeyboardButton(text="Ресурсы", callback_data="resources"),
            ],
        ]
    )


# =========================
# ОТПРАВКА МЕНЮ
# =========================
async def send_menu(user_id):
    await bot.send_photo(
        chat_id=user_id,
        photo=FSInputFile(PHOTO_PATH),
        caption="Панель управления",
        reply_markup=main_menu()
    )


# =========================
# /START
# =========================
@dp.message(CommandStart())
async def start(message: Message):
    uid = str(message.from_user.id)

    if uid in db and db[uid].get("approved"):
        await send_menu(message.from_user.id)
        return

    await message.answer(
        "Добро пожаловать в UDD team!\n\n"
        "Оставьте заявку:\n"
        "1. Опыт работы\n"
        "2. Рабочее время\n"
        "3. Откуда узнали о нас"
    )


# =========================
# ЗАЯВКА
# =========================
@dp.message()
async def form(message: Message):
    uid = str(message.from_user.id)

    if uid in db and db[uid].get("approved"):
        await send_menu(message.from_user.id)
        return

    db[uid] = {
        "form": message.text,
        "approved": False
    }

    save_db(db)

    await message.answer(
        f'Ваша заявка:\n\n"{message.text}"\n\nВсё верно?',
        reply_markup=confirm_keyboard()
    )


# =========================
# ПЕРЕПИСАТЬ
# =========================
@dp.callback_query(F.data == "rewrite_form")
async def rewrite(callback: CallbackQuery):
    await callback.message.answer(
        "Заполните заявку заново:\n\n"
        "1. Опыт работы\n"
        "2. Рабочее время\n"
        "3. Откуда узнали о нас"
    )
    await callback.answer()


# =========================
# ОТПРАВИТЬ + МОДЕРАЦИЯ
# =========================
@dp.callback_query(F.data == "send_form")
async def send(callback: CallbackQuery):
    uid = str(callback.from_user.id)

    await callback.message.answer(
        "Ваша заявка отправлена, ожидайте решения модерации."
    )

    await callback.answer()

    await asyncio.sleep(50)

    db[uid]["approved"] = True
    save_db(db)

    # СРАЗУ: ОДНО СООБЩЕНИЕ (ОДОБРЕНО + МЕНЮ)
    await bot.send_photo(
        chat_id=callback.from_user.id,
        photo=FSInputFile(PHOTO_PATH),
        caption="Ваша заявка была одобрена!\n\nПанель управления",
        reply_markup=main_menu()
    )


# =========================
# ПРОФИЛЬ
# =========================
@dp.callback_query(F.data == "profile")
async def profile(callback: CallbackQuery):
    await bot.send_photo(
        callback.from_user.id,
        FSInputFile(PHOTO_PATH),
        caption="Это ваш профиль."
    )
    await callback.answer()


# =========================
# ПРОЧИЕ КНОПКИ
# =========================
@dp.callback_query(F.data.in_({"mirror", "channels", "help", "settings", "resources"}))
async def other(callback: CallbackQuery):
    await callback.answer("Раздел в разработке", show_alert=True)


# =========================
# ЗАПУСК
# =========================
async def main():
    print("Bot started")
    await dp.start_polling(bot)


if __name__ == "__main__":
    asyncio.run(main())
